# modeldoki — Open WebUI Configuration
# Sourced by scripts/configure_openwebui.sh and scripts/configure_launchd.sh.

# Host and port the Open WebUI server binds to
OPENWEBUI_HOST=127.0.0.1
OPENWEBUI_PORT=3333

# LM Studio connection (OpenAI-compatible endpoint served by LM Studio).
# NOTE: Open WebUI reads OPENAI_API_BASE_URL (not OPENAI_BASE_URL), and the
# URL must include the /v1 suffix.
OPENAI_API_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_API_KEY=not-needed

# Default model shown in Open WebUI (informational; selectable in the UI)
OPENWEBUI_DEFAULT_MODEL=qwen2.5-7b-instruct

# WebUI settings
WEBUI_SECRET_KEY=modeldoki-openwebui-secret
WEBUI_DATA_DIR=${HOME}/.modeldoki/open-webui/data

# Log level: debug, info, warn, error
LOG_LEVEL=info
